# 本地开发配置 —— 只用于开发机！
#
# 0.3.0 起不得用于生产：这里全是弱口令。生产请用 deploy/setup.sh 生成
# server/.env（随机密钥），或复制 .env.example 后自行生成密钥。
# 代码侧契约（server-core 待实现）：生产模式启动时检测到这些开发值应拒绝或
# 至少打一条醒目告警；在实现之前，请靠流程保证不把本文件带进生产。
#
# 数据目录留空时使用仓库根目录下的 .localdata（见 observatory/core/config.py）。

# OBS_DATA_DIR=/data
OBS_SECRET_KEY=dev-only-secret-key-change-me-0123456789abcdef
OBS_ADMIN_PASSWORD=devpassword123
OBS_ENROLL_CODE=dev-enroll-code
# 开发机通常直连 8443，不经过 nginx，因此不信任转发头。
OBS_TRUST_FORWARDED_FOR=false
OBS_INSTALL_TOKEN_TTL_MINUTES=30

# 双域名：两个都提供安装脚本与受控端接口，控制台只在第一个域名提供
OBS_CONSOLE_HOST=control.tianhw.top
OBS_AGENT_HOSTS=observatory.123423.xyz,control.tianhw.top
OBS_PUBLIC_BASE_URLS=https://control.tianhw.top,https://observatory.123423.xyz
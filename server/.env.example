# Observatory 0.3.7 配置模板
#
#   cp server/.env.example server/.env
#   # 生成密钥：
#   python -c "import secrets;print(secrets.token_urlsafe(48))"    # OBS_SECRET_KEY
#
# 生产部署请用 deploy/setup.sh 生成随机密钥，不要直接复制本文件（更不要用
# server/.env.dev）。所有应用变量以 OBS_ 开头。

# ---- 身份与密钥 -------------------------------------------------------------
OBS_SECRET_KEY=请替换为48字节以上随机字符串
OBS_ADMIN_PASSWORD=请替换为强密码

# 设备注册是开放的：不需要共享注册码，也不需要安装票据。设备首次上线自动
# 建立记录并下发设备令牌；凭据只在后续请求里用（X-Device-Token）。
# 可选收紧：OBS_ENROLL_KEY 设置后，新设备的自动注册必须带上同一个部署密钥
# （只用于"新行准入"，不是逐台审批）。默认留空 = 完全开放。
# OBS_ENROLL_KEY=

# ---- 存储 -------------------------------------------------------------------
OBS_DATA_DIR=/data

# ---- 域名（双轨）------------------------------------------------------------
# 只有这个域名提供控制台
OBS_CONSOLE_HOST=control.tianhw.top
# 这些域名提供安装脚本与受控端接口（两个互为备份）
OBS_AGENT_HOSTS=observatory.123423.xyz,control.tianhw.top
# 受控端注册时拿到的地址列表，按顺序尝试
OBS_PUBLIC_BASE_URLS=https://control.tianhw.top,https://observatory.123423.xyz

# ---- 端口与信任边界（A11）---------------------------------------------------
# 8443 默认只绑回环，由本机 nginx 反代。
OBS_BIND_ADDR=127.0.0.1
OBS_PORT=8443
# 默认 false（代码侧）；只有 8443 绑定回环、前面是可信反代时才设 true。
# 直连暴露 8443 时保持 false，否则 X-Forwarded-For 可被伪造。
OBS_TRUST_FORWARDED_FOR=false

# ---- 容器（compose 层，A24）-------------------------------------------------
OBS_UID=10001
OBS_MEM_LIMIT=1g
OBS_CPUS=2.0
OBS_PIDS_LIMIT=256
# 镜像 ref：生产由 CI 传入 commit sha（pull-and-restart.sh 导出 OBS_IMAGE_TAG）；
# 手工 compose 时可用 OBS_IMAGE_TAG=latest。
# OBS_IMAGE_TAG=latest

# ---- 可选 -------------------------------------------------------------------
# OBS_SESSION_TTL_MINUTES=720
# OBS_MAX_FRAME_BYTES=6291456
# OBS_AGENT_OFFLINE_AFTER_S=120
# -*- coding: utf-8 -*-
"""Emit the USB installer package with correct encodings.

.ps1/.txt -> UTF-8 with BOM + CRLF (PowerShell 5.1 parses BOM-less as ANSI).
.cmd      -> ASCII-only content + CRLF (cmd.exe parses with the console code page).
"""
from pathlib import Path

OUT = Path(__file__).resolve().parent

CMD_INSTALL = r'''@echo off
rem Observatory USB one-click installer (entry point).
rem The real logic lives in usb-install.ps1 next to this file.
setlocal EnableExtensions
title Observatory USB installer
echo.
echo   ==================================================
echo      Observatory agent - USB one-click installer
echo      machine: %COMPUTERNAME%
echo      A UAC prompt will appear once during install.
echo   ==================================================
echo.
powershell -NoProfile -ExecutionPolicy Bypass -File "%~dp0usb-install.ps1" %*
set "RC=%ERRORLEVEL%"
echo.
if "%RC%"=="0" (
  echo   Result: SUCCESS. This machine is now managed.
) else (
  echo   Result: FAILED ^(exit code %RC%^). Read the messages above.
)
echo.
pause
endlocal & exit /b %RC%
'''

CMD_MINT = r'''@echo off
rem Mint a fresh batch of one-time install tokens into tokens.txt.
setlocal EnableExtensions
title Observatory token minter
echo.
echo   ==================================================
echo      Observatory - mint install tokens
echo      Adds one-time tokens to tokens.txt on this USB.
echo      You will be asked for the console admin password.
echo   ==================================================
echo.
powershell -NoProfile -ExecutionPolicy Bypass -File "%~dp0mint-tokens.ps1" %*
set "RC=%ERRORLEVEL%"
echo.
pause
endlocal & exit /b %RC%
'''

PS_INSTALL = r'''<#
.SYNOPSIS
    Observatory U 盘批量安装器（令牌池版）。

.DESCRIPTION
    一台机器消费一张一次性安装令牌（0.3.1 安全设计：令牌绑定首台
    注册它的设备，外泄令牌无法抢注多台机器）。本脚本自动从 tokens.txt
    里挑选尚未使用的令牌，调用服务器渲染的正式 install.ps1 完成安装，
    并在确认注册成功后把该令牌记入 used.txt —— 换下一台机器插上 U 盘
    再双击即可，无需任何手动操作。

    重装同一台曾在控制台删除过的机器：管理员先在服务端清除删除记录，
    然后运行: 一键安装.cmd 会在检测到旧身份时提示；或手动
    powershell -ExecutionPolicy Bypass -File usb-install.ps1 -ResetIdentity
#>
[CmdletBinding()]
param(
    [string[]]$BaseUrls = @('https://control.tianhw.top', 'https://observatory.123423.xyz'),
    [int]$EnrollGraceSeconds = 90,
    [switch]$ResetIdentity,
    [switch]$Elevated
)

$ErrorActionPreference = 'Stop'
$ProgressPreference = 'SilentlyContinue'
try { [Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12 } catch { }

$ScriptDir   = $PSScriptRoot
$TokensFile  = Join-Path $ScriptDir 'tokens.txt'
$UsedFile    = Join-Path $ScriptDir 'used.txt'
$ServiceName = 'ObservatoryAgent'
$AgentDataDir = Join-Path $env:ProgramData 'Observatory'

function Write-Info { param([string]$m) Write-Host "  [$(Get-Date -Format 'HH:mm:ss')] $m" -ForegroundColor Cyan }
function Write-Ok   { param([string]$m) Write-Host "  $m" -ForegroundColor Green }
function Write-Warn2{ param([string]$m) Write-Host "  $m" -ForegroundColor Yellow }
function Write-Err2 { param([string]$m) Write-Host "  [错误] $m" -ForegroundColor Red }

function Test-Admin {
    $identity = [Security.Principal.WindowsIdentity]::GetCurrent()
    $principal = New-Object Security.Principal.WindowsPrincipal($identity)
    return $principal.IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)
}

function Resolve-BaseUrls {
    foreach ($url in $BaseUrls) {
        $candidate = $url.TrimEnd('/')
        try {
            $health = Invoke-RestMethod -Uri "$candidate/api/v1/health" -TimeoutSec 10 -UseBasicParsing
            Write-Info "服务器可达: $candidate (版本 $($health.version))"
            return $candidate
        } catch { }
    }
    return $null
}

function Test-Token {
    # GET /public/install.cmd 只校验令牌、不消费它（消费发生在受控端注册）。
    # 200 = 未使用; 401 = 已被使用/无效; 其余 = 网络 or 限流异常。
    param([string]$Base, [string]$Token)
    $uri = "$Base/api/v1/public/install.cmd?token=$([uri]::EscapeDataString($Token))"
    try {
        Invoke-WebRequest -Uri $uri -UseBasicParsing -TimeoutSec 20 | Out-Null
        return 'valid'
    } catch {
        $code = 0
        try { $code = [int]$_.Exception.Response.StatusCode } catch { }
        if ($code -eq 401) { return 'dead' }
        if ($code -eq 429) { return 'throttled' }
        return "error:$code"
    }
}

function Add-Used {
    param([string]$Token, [string]$Note)
    $line = "{0}`t{1}`t{2}" -f $Token, (Get-Date -Format 'yyyy-MM-dd HH:mm:ss'), $Note
    Add-Content -LiteralPath $UsedFile -Value $line -Encoding ASCII
}

# --- 重置身份需要管理员（仅 -ResetIdentity 时才会走这里） ---
if ($ResetIdentity -and -not $Elevated -and -not (Test-Admin)) {
    Write-Info '重置设备身份需要管理员权限，正在请求 UAC ...'
    $proc = Start-Process -FilePath 'powershell.exe' -Verb RunAs -PassThru -ArgumentList @(
        '-NoProfile', '-ExecutionPolicy', 'Bypass', '-File', ("`"{0}`"" -f $PSCommandPath),
        '-ResetIdentity', '-Elevated'
    )
    exit 0
}

Write-Host ''
Write-Host '  ==================================================' -ForegroundColor DarkGray
Write-Host '     Observatory U 盘一键安装（令牌池）' -ForegroundColor White
Write-Host "     目标机 : $env:COMPUTERNAME" -ForegroundColor Gray
Write-Host '  ==================================================' -ForegroundColor DarkGray
Write-Host ''

if (-not (Test-Path $TokensFile)) {
    Write-Err2 "找不到 tokens.txt（应与本脚本同目录）。双击「生成令牌.cmd」生成。"
    exit 2
}

$all = @(Get-Content -LiteralPath $TokensFile | ForEach-Object { $_.Trim() } | Where-Object { $_ -and $_ -notlike '#*' })
$used = @()
if (Test-Path $UsedFile) {
    $used = @(Get-Content -LiteralPath $UsedFile | ForEach-Object { ($_ -split "`t")[0].Trim() } | Where-Object { $_ -and $_ -notlike '#*' })
}
$candidates = @($all | Where-Object { $used -notcontains $_ })

Write-Info ("令牌池: 共 {0} 张，已用 {1} 张，可用 {2} 张" -f $all.Count, $used.Count, $candidates.Count)
if ($candidates.Count -eq 0) {
    Write-Err2 '没有可用令牌。双击「生成令牌.cmd」补充（需要控制台管理员密码），或在控制台「安装令牌」页生成后一行一张粘贴进 tokens.txt。'
    exit 2
}

$base = Resolve-BaseUrls
if (-not $base) {
    Write-Err2 '两个服务器地址都不可达，请检查本机网络。'
    exit 3
}

if ($ResetIdentity -and (Test-Admin)) {
    $svc = Get-Service -Name $ServiceName -ErrorAction SilentlyContinue
    if ($svc) { try { Stop-Service -Name $ServiceName -Force -ErrorAction Stop } catch { } }
    Get-Process -Name 'observatory-agent' -ErrorAction SilentlyContinue | ForEach-Object {
        try { Stop-Process -Id $_.Id -Force -ErrorAction Stop } catch { }
    }
    Start-Sleep -Milliseconds 700
    $cfg = Join-Path $AgentDataDir 'config.json'
    if (Test-Path $cfg) {
        Remove-Item -LiteralPath $cfg -Force
        Write-Info '已删除旧设备身份 config.json —— 本机将作为全新设备注册。'
    }
}

$installer = Join-Path $env:TEMP ("observatory-usb-install-{0}.ps1" -f $PID)
$overall = 1

foreach ($token in $candidates) {
    $hint = $token.Substring(0, [Math]::Min(8, $token.Length))
    $status = Test-Token -Base $base -Token $token

    if ($status -eq 'dead') {
        Add-Used -Token $token -Note 'skip: already used'
        continue
    }
    if ($status -eq 'throttled') {
        Write-Warn2 '服务器限流，等待 30 秒后重试 ...'
        Start-Sleep -Seconds 30
        $status = Test-Token -Base $base -Token $token
    }
    if ($status -ne 'valid') {
        Write-Warn2 "令牌 $hint... 校验异常 ($status)，跳过"
        continue
    }

    Write-Info "使用令牌 $hint... （安装过程中会弹一次 UAC）"
    try {
        Invoke-WebRequest -Uri "$base/api/v1/public/install.ps1?token=$([uri]::EscapeDataString($token))" `
            -OutFile $installer -UseBasicParsing -TimeoutSec 60 | Out-Null
    } catch {
        Write-Warn2 "安装脚本下载失败: $($_.Exception.Message)"
        continue
    }

    & powershell.exe -NoProfile -ExecutionPolicy Bypass -File $installer -Token $token
    $rc = $LASTEXITCODE
    Remove-Item -LiteralPath $installer -Force -ErrorAction SilentlyContinue

    if ($rc -eq 4) { Write-Err2 'UAC 被取消，安装中止。'; exit 4 }
    if ($rc -eq 3) { Write-Err2 '网络不可达，安装中止。'; exit 3 }

    # 轮询该令牌是否已被本机受控端注册消费（消费 = 注册成功）
    $consumed = $false
    $deadline = (Get-Date).AddSeconds($EnrollGraceSeconds)
    while ((Get-Date) -lt $deadline) {
        Start-Sleep -Seconds 3
        if ((Test-Token -Base $base -Token $token) -eq 'dead') { $consumed = $true; break }
    }

    if ($consumed) {
        Add-Used -Token $token -Note ("enrolled by {0}" -f $env:COMPUTERNAME)
        Write-Ok '安装完成，设备已注册并出现在控制台。'
        Write-Ok '控制台: https://control.tianhw.top'
        $overall = 0
        break
    }

    if ($rc -ne 0) {
        Write-Warn2 "安装器退出码 $rc，换下一张令牌重试 ..."
        continue
    }

    Write-Warn2 ("安装完成但 {0} 秒内未确认注册（受控端会继续自动重试）。" -f $EnrollGraceSeconds)
    Write-Warn2 '若本机曾在控制台被删除过设备，注册会被拒绝（墓碑保护），需管理员在服务端清除后重试。'
    $overall = 0
    break
}

if ($overall -ne 0) {
    Write-Err2 '所有可用令牌都无法完成安装。常见原因：令牌全部过期（双击「生成令牌.cmd」补充）；'
    Write-Err2 '或本机曾在控制台被删除（墓碑拒绝注册）—— 请管理员处理后再试。'
}
exit $overall
'''

PS_MINT = r'''<#
.SYNOPSIS
    为 U 盘令牌池补充一次性安装令牌。

.DESCRIPTION
    调用控制台管理 API 批量生成一次性安装令牌并追加到 tokens.txt。
    需要输入控制台管理员密码（仅本次使用，不会保存到 U 盘）。
    令牌默认有效期 24 小时，请在有效期内完成安装。
#>
[CmdletBinding()]
param(
    [int]$Count = 30,
    [string[]]$BaseUrls = @('https://control.tianhw.top', 'https://observatory.123423.xyz')
)

$ErrorActionPreference = 'Stop'
$ProgressPreference = 'SilentlyContinue'
try { [Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12 } catch { }

$TokensFile = Join-Path $PSScriptRoot 'tokens.txt'

function Resolve-BaseUrls {
    foreach ($url in $BaseUrls) {
        $candidate = $url.TrimEnd('/')
        try {
            Invoke-RestMethod -Uri "$candidate/api/v1/health" -TimeoutSec 10 -UseBasicParsing | Out-Null
            return $candidate
        } catch { }
    }
    return $null
}

$base = Resolve-BaseUrls
if (-not $base) { Write-Host '[错误] 两个服务器地址都不可达。' -ForegroundColor Red; exit 3 }

$secure = Read-Host '控制台管理员密码' -AsSecureString
$bstr = [Runtime.InteropServices.Marshal]::SecureStringToBSTR($secure)
$password = [Runtime.InteropServices.Marshal]::PtrToStringBSTR($bstr)
[Runtime.InteropServices.Marshal]::ZeroFreeBSTR($bstr)

$bearer = $null
try {
    $login = Invoke-RestMethod -Uri "$base/api/v1/auth/login" -Method Post -ContentType 'application/json' `
        -Body (@{ password = $password } | ConvertTo-Json) -UseBasicParsing -TimeoutSec 30
    if ($login.data -and $login.data.token) { $bearer = $login.data.token }
    elseif ($login.token) { $bearer = $login.token }
} catch {
    Write-Host '[错误] 登录失败：密码错误，或已开启二次验证（需在控制台网页登录）。' -ForegroundColor Red
    exit 2
}
if (-not $bearer) { Write-Host '[错误] 登录响应异常。' -ForegroundColor Red; exit 2 }

$headers = @{ Authorization = "Bearer $bearer" }
$ok = 0
for ($i = 1; $i -le $Count; $i++) {
    try {
        $resp = Invoke-RestMethod -Uri "$base/api/v1/install-tokens" -Method Post -Headers $headers `
            -ContentType 'application/json' -Body '{}' -UseBasicParsing -TimeoutSec 30
        $t = $null
        if ($resp.data -and $resp.data.token) { $t = $resp.data.token }
        elseif ($resp.token) { $t = $resp.token }
        if ($t) {
            Add-Content -LiteralPath $TokensFile -Value $t -Encoding ASCII
            $ok++
            Write-Host -NoNewline '.'
        } else { Write-Host -NoNewline 'x' }
    } catch {
        Write-Host -NoNewline 'x'
    }
}
Write-Host ''
if ($ok -gt 0) {
    Write-Host ("  已生成 {0}/{1} 张令牌并追加到 tokens.txt（有效期 24 小时）。" -f $ok, $Count) -ForegroundColor Green
    exit 0
}
Write-Host '  [错误] 一张都没有生成（会话可能已过期，重新运行再输一次密码）。' -ForegroundColor Red
exit 1
'''

README = '''Observatory 受控端 U 盘一键安装包
====================================

用法（每台目标机重复一次）
--------------------------
1. U 盘插到目标机，双击「一键安装.cmd」。
2. 弹出 UAC 时点“是”（整个生命周期只有这一次提权）。
3. 看到 “安装完成，设备已注册” 即可拔盘换下一台。设备会出现在
   控制台 https://control.tianhw.top 的设备墙里。

工作原理
--------
- 一个一次性安装令牌只能注册一台机器（0.3.1 安全设计：令牌绑定
  首台使用它的设备，U 盘丢失也不会被人批量抢注设备）。
- 本安装包内置一个“令牌池”（tokens.txt），脚本自动为每台机器挑
  一张未使用的令牌，装完自动记到 used.txt，换机器无需任何手动操作。
- 安装包与安装脚本每次都从服务器实时下载，版本永远与服务器一致，
  以后升级走自动更新，无需重新安装。

令牌用完了 / 过期了怎么办
------------------------
令牌有效期 24 小时。双击「生成令牌.cmd」，输入控制台管理员密码，
即可再生成 30 张追加进 tokens.txt（也可在控制台「安装令牌」页手工
生成，一行一张粘贴进 tokens.txt）。

注意事项
--------
- 目标机需要能访问外网（control.tianhw.top 或 observatory.123423.xyz）。
- 在“这台机器曾经装过、又在控制台被删除过”的机器上重装会被拒绝
  （删除保护）。需管理员在服务端清除该机的删除记录后，运行：
  powershell -ExecutionPolicy Bypass -File usb-install.ps1 -ResetIdentity
- 卸载受控端：管理员运行
  "C:\\Program Files\\Observatory\\observatory-agent.exe" --uninstall
- U 盘里的 tokens.txt 是机密：谁能读到它，谁就能在有效期内注册
  设备。U 盘不用时请妥善保管。
'''

def write(path: Path, text: str, *, ascii_only: bool) -> None:
    text = text.replace('\r\n', '\n').replace('\n', '\r\n')
    if ascii_only:
        data = text.encode('ascii')
    else:
        data = text.encode('utf-8-sig')
    path.write_bytes(data)
    print(f'{path.name}: {len(data)} bytes')

write(OUT / '一键安装.cmd', CMD_INSTALL, ascii_only=True)
write(OUT / '生成令牌.cmd', CMD_MINT, ascii_only=True)
write(OUT / 'usb-install.ps1', PS_INSTALL, ascii_only=False)
write(OUT / 'mint-tokens.ps1', PS_MINT, ascii_only=False)
write(OUT / 'README.txt', README, ascii_only=False)
(OUT / 'used.txt').write_bytes(b'')
print('used.txt: 0 bytes (created empty)')
print('DONE')

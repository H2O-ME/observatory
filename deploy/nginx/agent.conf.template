# 受控端域名 vhost 模板（Observatory 0.3.0）
#
# 不要直接安装这个文件：deploy/setup.sh 会替换占位符后写到
# /etc/nginx/sites-available/observatory-agent.conf。
#
# 这个域名只提供：受控端接入（/api/v1/agent/，含协议 v3 的 /agent/link）、
# 公共接口（安装脚本/安装包/健康/版本）。控制台页面与后台接口一律 404，
# 应用层 HostSplit 还会再拦一次（Host 头可伪造）。
#
# 占位符同 console.conf.template：@@CONSOLE_HOST@@ / @@AGENT_HOST@@ / @@CERT_NAME@@

# 80 端口（ACME + HTTP→HTTPS 跳转）统一由 console.conf.template 的 80 块承担，
# 这里不再重复定义 server_name，避免 nginx 报 conflicting server name。
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name @@AGENT_HOST@@;

    ssl_certificate     /etc/letsencrypt/live/@@CERT_NAME@@/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/@@CERT_NAME@@/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;

    # 受控端域名也必须记日志：设备连不上时先看源站有没有收到请求。
    access_log /var/log/nginx/observatory-agent.access.log;
    error_log  /var/log/nginx/observatory-agent.error.log warn;

    client_max_body_size 600m;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;

    # 控制台页面与后台接口一律不对外。
    location = / {
        default_type text/plain;
        return 404 "该域名仅用于受控端接入与安装，控制台请访问 https://@@CONSOLE_HOST@@\n";
    }

    location ^~ /assets/ {
        default_type text/plain;
        return 404 "该域名仅用于受控端接入与安装\n";
    }

    location ^~ /api/v1/auth/ {
        default_type text/plain;
        return 404 "该域名仅用于受控端接入与安装\n";
    }

    location ^~ /api/v1/devices {
        default_type text/plain;
        return 404 "该域名仅用于受控端接入与安装\n";
    }

    location ^~ /api/v1/settings {
        default_type text/plain;
        return 404 "该域名仅用于受控端接入与安装\n";
    }

    location ^~ /api/v1/audit {
        default_type text/plain;
        return 404 "该域名仅用于受控端接入与安装\n";
    }

    location ^~ /api/v1/updates {
        default_type text/plain;
        return 404 "该域名仅用于受控端接入与安装\n";
    }

    location ^~ /api/v1/system {
        default_type text/plain;
        return 404 "该域名仅用于受控端接入与安装\n";
    }

    location ^~ /api/v1/control {
        default_type text/plain;
        return 404 "该域名仅用于受控端接入与安装\n";
    }

    location ^~ /api/v1/files {
        default_type text/plain;
        return 404 "该域名仅用于受控端接入与安装\n";
    }

    location ^~ /api/v1/backup {
        default_type text/plain;
        return 404 "该域名仅用于受控端接入与安装\n";
    }

    location ^~ /api/v1/events {
        default_type text/plain;
        return 404 "该域名仅用于受控端接入与安装\n";
    }

    location ^~ /api/v1/ws {
        default_type text/plain;
        return 404 "该域名仅用于受控端接入与安装\n";
    }

    # 只有这些路径透传到应用：受控端接口（含 v3 /agent/link）、安装脚本、版本与健康检查。
    location /api/v1/agent/ {
        proxy_pass https://127.0.0.1:8443;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_ssl_server_name on;
        proxy_ssl_verify off;
        proxy_buffering off;
    }

    location /api/v1/public/ {
        proxy_pass https://127.0.0.1:8443;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_ssl_server_name on;
        proxy_ssl_verify off;
    }

    location = /api/v1/health {
        proxy_pass https://127.0.0.1:8443;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_ssl_verify off;
    }

    location = /api/v1/version {
        proxy_pass https://127.0.0.1:8443;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_ssl_verify off;
    }

    # 旧版短链 /install.ps1 兼容：内部改写到新路径（查询参数保留）。
    location = /install.ps1 {
        rewrite ^ /api/v1/public/install.ps1 last;
    }

    location / {
        default_type text/plain;
        return 404 "该域名仅用于受控端接入与安装，控制台请访问 https://@@CONSOLE_HOST@@\n";
    }
}
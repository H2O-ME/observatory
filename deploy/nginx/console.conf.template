# 控制台域名 vhost 模板（Observatory 0.3.0）
#
# 不要直接安装这个文件：deploy/setup.sh 会替换占位符后写到
# /etc/nginx/sites-available/observatory-console.conf。
#
# 占位符：
#   @@CONSOLE_HOST@@  控制台域名（唯一允许控制台 UI 的 Host）
#   @@AGENT_HOST@@    受控端域名（同一张证书的 SAN）
#   @@CERT_NAME@@     certbot lineage 名（/etc/letsencrypt/live/<name>/）
#
# 控制台域名同时提供受控端接口（双域名互备）。

server {
    listen 80;
    listen [::]:80;
    # 两个域名共用这一个 80 端口块：唯一职责是 ACME 校验 +
    # 把 HTTP 跳到同名的 HTTPS（$host 保留 control/agent 域名）。
    server_name @@CONSOLE_HOST@@ @@AGENT_HOST@@;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name @@CONSOLE_HOST@@;

    ssl_certificate     /etc/letsencrypt/live/@@CERT_NAME@@/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/@@CERT_NAME@@/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    # 521 排查（CDN→源站）：没有这两行时，源站到底有没有收到 CDN 请求、
    # 还是 nginx/容器在重启，日志里都看不见（2026-10-24 的 20 分钟 521）。
    access_log /var/log/nginx/observatory-console.access.log;
    error_log  /var/log/nginx/observatory-console.error.log warn;

    client_max_body_size 600m;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;

    # 0.3.1（F49）：Vite 产物 1-3MB 不压缩时弱带宽服务器首屏明显变慢；
    # API JSON 同收益。文本类型压缩，二进制（帧/包）交给上游原样传输。
    gzip on;
    gzip_vary on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types application/javascript application/json text/css text/plain image/svg+xml;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;

    location / {
        proxy_pass https://127.0.0.1:8443;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_ssl_server_name on;
        proxy_ssl_verify off;
        proxy_buffering off;
    }

    # 0.3.1（F49）：大包上传（600m）默认整包落 nginx 磁盘缓冲再转发，
    # 小盘/慢盘上双倍 IO。上传路径流式直通。
    location /api/v1/updates/agent {
        proxy_pass https://127.0.0.1:8443;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_ssl_server_name on;
        proxy_ssl_verify off;
        proxy_buffering off;
        proxy_request_buffering off;
    }
}
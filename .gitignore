# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
# 注意：这里不要写通用的 build/ 或 dist/。那会把 agent/build/ 整个目录一起
# 忽略掉——agent/build/ 装的是受控端的构建定义（PyInstaller spec、entry.py、
# build.ps1），属于源码，必须进仓库，否则 CI 上没有构建脚本可用。
/build/
/dist/
*.spec.bak

# ---- Runtime data (never commit local captures or secrets) ----
.localdata/
data/
*.db
*.db-wal
*.db-shm
server/.env

# ---- Node / WebUI ----
webui/node_modules/
webui/dist/
webui/.tsbuildinfo
webui/*.tsbuildinfo

# ---- Agent build artefacts ----
agent/build/build/
agent/build/dist/
agent/dist/
*.zip

# ---- Deployment secrets / artefacts ----
certs/
backups/
.wine-agent/
server/.env.local

# ---- Editors / OS ----
.git-credentials
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# ---- Local tooling ----
.zcode/
skills-lock.json
# ---- 重构期临时产物（不入库） ----
tmp_w0/
.pytest-tmp/
tmp_w1/
# win_smoke 本机冒烟产物（tools/win_smoke.py 的运行目录）
.win-smoke/
